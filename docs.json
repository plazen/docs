{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Plazen Documentation",
  "colors": {
    "primary": "#43B2AC",
    "light": "#43B2AC",
    "dark": "#00739D"
  },
  "favicon": "/images/favicon.ico",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Release Notes",
          "icon": "newspaper",
          "color": {
            "light": "#43B2AC",
            "dark": "#43B2AC"
          },
          "href": "https://plazen.org/release-notes"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Self-hosting",
            "icon": "database",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "For Developers",
            "icon": "computer",
            "pages": [
              "dev/introduction",
              "dev/setup"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "apis/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": []
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/image.png",
    "dark": "/images/logo2.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@plazen.org"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://dashboard.mintlify.com"
    }
  },
  "contextual": {
    "options": [
     "copy",
     "view",
     "chatgpt",
     "claude",
     "perplexity",
     "mcp",
     "cursor",
     "vscode"
   ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/plazen",
      "instagram": "https://instagram.com/plazenorg",
      "threads": "https://threads.net/@plazenorg",
      "website": "https://plazen.org"
    }
  },
  "background": {
    "color": {
      "dark": "#030609",
      "light": "#F6F9FB"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "fonts": {
    "family": "Mona Sans",
    "heading": {
      "family": "Mona Sans"
    },
    "body": {
      "family": "Mona Sans"
    }
  }
}
